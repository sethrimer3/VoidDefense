{
  "name": "void-defense",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-transform-types --import ./tests/pin-random.ts --test tests/*.test.ts",
    "test:pointer": "node tests/defend-pointer.mjs",
    "test:performance": "node tests/defend-performance.mjs",
    "test:stress": "node tests/defend-stress.mjs",
    "test:stress-ui": "node tests/defend-stress-ui.mjs",
    "test:render-cache": "node tests/defend-render-cache.mjs",
    "font": "node --experimental-transform-types scripts/pixel-font/build.ts",
    "export-sprites": "node tools/export-sprites.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "@playwright/test": "^1.55.1"
  }
}
